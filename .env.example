# Directorio de datos procesados y crudos (relativo o absoluto)
DATA_DIR=data/processed

# Orígenes CORS permitidos (separados por coma). El frontend vive en otro repo (trinity-nasa-team/MarsWalk-web):
# en producción agrega aquí su dominio de Vercel, p. ej. https://marswalk-web.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Rate limiting de endpoints de cálculo (solicitudes por minuto por IP)
RATE_LIMIT_PER_MINUTE=30

# Timeout máximo de cómputo en segundos
COMPUTE_TIMEOUT_SECONDS=10

# IA del hábitat (018): clave de Groq (console.groq.com). Solo en el backend; nunca en el frontend.
# Arranca uvicorn con `--env-file .env` para que la lea.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# CHAT_RATE_LIMIT_PER_MINUTE=12

# API key de NASA (opcional para descargas manuales / InSight)
# NASA_API_KEY=DEMO_KEY
